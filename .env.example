# Salin file ini menjadi ".env" lalu isi API key Anda. Jangan unggah .env ke publik.
# Gemini API key gratis: https://aistudio.google.com/apikey
GEMINI_API_KEY=MASUKKAN_API_KEY_GEMINI_DI_SINI
GEMINI_MODEL=gemini-flash-latest

# Opsional (untuk perbandingan model di halaman Eksperimen Prompt)
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
XAI_API_KEY=
